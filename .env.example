# ==============================================================================
# KleanFlow Laundry Management System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# ==============================================================================


# ── Flask Environment ─────────────────────────────────────────────────────────
# Options: development | testing | production
FLASK_ENV=production

# Application Entry Point (used by flask CLI commands)
FLASK_APP=run.py


# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Replace with a strong random secret key in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Enforce HTTPS-only cookies in production (set False for local HTTP dev)
SESSION_COOKIE_SECURE=True

# Prevent JavaScript access to session cookie
SESSION_COOKIE_HTTPONLY=True

# Cross-Site cookie policy: Strict | Lax | None
SESSION_COOKIE_SAMESITE=Lax


# ── Business Settings ─────────────────────────────────────────────────────────
BUSINESS_NAME=KleanFlow Laundry Services

# ISO 4217 currency code (GHS = Ghanaian Cedi)
CURRENCY=GHS

# Tax rate applied to orders (0.00 = no tax)
TAX_RATE=0.00


# ── Database: MySQL (Production) ──────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=kleanflow_user
MYSQL_PASSWORD=secure_password_here
MYSQL_DATABASE=kleanflow_db

# Alternative — full URI overrides individual settings above if uncommented
# DATABASE_URL=mysql+pymysql://kleanflow_user:secure_password_here@localhost:3306/kleanflow_db

# ── Database: SQLite (Development / Testing) ──────────────────────────────────
# Uncomment for quick local development (no MySQL needed)
# DATABASE_URL=sqlite:///instance/kleanflow_dev.db


# ── File Uploads ──────────────────────────────────────────────────────────────
# Directory for user-uploaded files (relative to app root or absolute path)
UPLOAD_FOLDER=uploads

# Maximum file size for uploads (in bytes, default 16 MB)
MAX_CONTENT_LENGTH=16777216


# ── Gunicorn WSGI Server (Production) ────────────────────────────────────────
# Binding address and port
GUNICORN_BIND=0.0.0.0:5000

# Worker processes — rule of thumb: (CPU cores × 2) + 1
GUNICORN_WORKERS=4

# Threads per worker
GUNICORN_THREADS=2

# Worker timeout in seconds
GUNICORN_TIMEOUT=120

# Log level: debug | info | warning | error | critical
GUNICORN_LOG_LEVEL=info

# Log file paths (use "-" for stdout/stderr)
GUNICORN_ACCESS_LOG=logs/access.log
GUNICORN_ERROR_LOG=logs/error.log
