# KleanFlow Laundry Management System — Environment Configuration Template

# Environment Mode (development, testing, production)
FLASK_ENV=production

# Application Secret Key (MUST be set to a strong random key in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Business Settings
BUSINESS_NAME=KleanFlow Laundry Services
CURRENCY=GHS
TAX_RATE=0.00

# Database Configuration (MySQL 8+)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=kleanflow_user
MYSQL_PASSWORD=secure_password_here
MYSQL_DATABASE=kleanflow_db

# Alternative Database Connection URI (Overrides MySQL settings if specified)
# DATABASE_URL=mysql+pymysql://kleanflow_user:secure_password_here@localhost:3306/kleanflow_db

# File Upload Settings
UPLOAD_FOLDER=uploads

# Security Settings
SESSION_COOKIE_SECURE=True

# Gunicorn Production Server Settings
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_LOG_LEVEL=info
